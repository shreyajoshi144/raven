# Copy to .env and fill in. NEVER commit .env. Generate strong secrets with: ./scripts/generate-secrets.sh
# ---- required ----
POSTGRES_PASSWORD=
# >= 32 chars; signs CSRF tokens
APP_SECRET_KEY=
# >= 32 chars; n8n -> API authentication (must differ from the others)
INTERNAL_SERVICE_SECRET=
# >= 32 chars; API -> n8n authentication
N8N_WEBHOOK_SECRET=
# >= 32 chars; encrypts n8n's stored data
N8N_ENCRYPTION_KEY=
# ---- language model (optional; without it docs/Q&A fall back to deterministic, clearly-labelled output) ----
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# ---- optional ----
# raises GitHub's rate limit from 60/h to 5000/h; needs no scopes (public data only)
GITHUB_TOKEN=
ALLOW_REGISTRATION=true
COOKIE_SECURE=true           # keep true behind HTTPS; set false ONLY for plain-http localhost trials
MAX_CONCURRENT_ANALYSES=2
MAX_ANALYSIS_SECONDS=600
RAVEN_PORT=8000
N8N_EDITOR_PORT=5678
LOG_LEVEL=INFO
# ---- accounts / email (needed for public sign-ups) ----
# true = new accounts must confirm their email before they can sign in. Requires SMTP_HOST in production.
REQUIRE_EMAIL_VERIFICATION=false
# public URL used in emailed links (verification, password reset)
APP_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Raven <no-reply@example.com>
# ---- optional deployment profiles (docker compose --profile proxy|backup|monitor up -d) ----
# domain for the Caddy HTTPS proxy (DNS must point at this host)
RAVEN_DOMAIN=
BACKUP_KEEP_DAYS=14
# 0 = keep analyses forever
ANALYSIS_RETENTION_DAYS=0
# Slack/Discord/Teams-compatible webhook for health alerts
ALERT_WEBHOOK_URL=
# ---- optional: fallback model (tried when the primary fails with an availability error) ----
# anthropic or openai_compat (any OpenAI-compatible endpoint, e.g. vLLM/Ollama)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
# Optional USD list prices per million tokens; GET /analyses/{id}/usage reports cost only when both are set
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# ---- optional: semantic retrieval via an OpenAI-compatible /v1/embeddings endpoint (unset = lexical only) ----
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
