      "parameters": {
        "jsCode": "function eq(a,b){if(typeof a!=='string'||typeof b!=='string'||a.length!==b.length)return false;let r=0;for(let i=0;i<a.length;i++)r|=a.charCodeAt(i)^b.charCodeAt(i);return r===0;}\nconst UUID = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;\nconst req = $input.first().json;\nconst body = req.body || {};\nconst secret = $env.RAVEN_N8N_WEBHOOK_SECRET || $env.N8N_WEBHOOK_SECRET;\nconst authorized = eq(String((req.headers || {})['x-raven-webhook-secret'] || ''), String(secret || '')) && !!secret;\nconst valid = UUID.test(String(body.analysis_id || '')) && UUID.test(String(body.doc_id || ''));\nreturn [{ json: { authorized: authorized && valid, state: { analysis_id: body.analysis_id, doc_id: body.doc_id, execId: String($execution.id), step: 'explain', dispatchTries: 0, polls: 0, attempt: 0 } } }];"
