        "jsCode": "const s = $input.first().json.state || $('Init').first().json.state;\nconst kind = s.step === 'explain' ? 'docs_explain' : 'docs_assemble';\nconst key = s.execId + ':' + kind + ':' + s.attempt + ':' + s.dispatchTries;\nreturn [{ json: { state: s, req: { kind, workflow: 'raven_documentation_generation', execution_id: s.execId, doc_id: s.doc_id, idempotency_key: key } } }];"
      },
