 "qa": [
  {
   "id": "ft-q1",
   "category": "auth",
   "question": "How does the API authenticate the current user from a request?",
   "answerable": true,
   "expected_answer": "api/deps.py defines reusable_oauth2 = OAuth2PasswordBearer(tokenUrl=f\"{settings.API_V1_STR}/login/access-token\"). get_current_user decodes the bearer JWT with settings.SECRET_KEY and security.ALGORITHM, loads the User, and rejects missing (404) or inactive (400) users; routes receive it through the CurrentUser annotation.",
   "key_facts": [
    [
     "OAuth2PasswordBearer",
     "jwt",
     "bearer"
    ],
    [
     "get_current_user",
     "CurrentUser"
    ]
   ],
   "evidence": [
    {
     "path": "backend/app/api/deps.py",
     "start_line": 16,
     "end_line": 18,
     "anchor": "OAuth2PasswordBearer"
