# TLS reverse proxy (automatic HTTPS). Start with: docker compose --profile proxy up -d   (needs RAVEN_DOMAIN with DNS pointing at this host, ports 80/443 open)
{$RAVEN_DOMAIN:localhost} {
	encode zstd gzip
	@internal path /internal/* /api/docs /api/openapi.json /docs /openapi.json
	respond @internal 404
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy api:8000
}
